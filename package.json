{
  "name": "clothing-commerce-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Secure desktop foundation for the in-store commerce sales channel",
  "author": "Shifted",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "gen:runtime-config": "node scripts/generate-runtime-config.mjs",
    "build": "pnpm gen:runtime-config && pnpm build:main && pnpm build:renderer && electron-builder --dir",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && pnpm build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integration:check": "node scripts/integration-check.mjs",
    "lint": "eslint .",
    "origin:check": "node scripts/origin-check.mjs",
    "acceptance:origin": "node scripts/origin-check.mjs",
    "acceptance:persistence": "pnpm build:main && node scripts/run-persistence-acceptance.mjs",
    "acceptance:sqlite-packaged": "node scripts/run-sqlite-package-acceptance.mjs",
    "acceptance:returns": "pnpm build:main && node scripts/run-returns-acceptance.mjs",
    "acceptance:sale-recovery": "pnpm build:main && node scripts/run-sale-recovery-acceptance.mjs",
    "acceptance:offline-ack": "pnpm build:main && node scripts/run-offline-ack-acceptance.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@clerk/react": "6.15.1",
    "@shifted/clothing-commerce-sdk": "file:vendor/shifted-clothing-commerce-sdk-0.17.0.tgz",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.shifted.commerce.pos",
    "productName": "Commerce POS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
